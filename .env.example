# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# For Vercel/Vite deployments, use VITE_GEMINI_API_KEY.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Voice Model: The Gemini model used for real-time voice interaction.
VITE_VOICE_MODEL="gemini-2.5-flash-native-audio-preview-12-2025"

# TTS Model: The Gemini model used for text-to-speech testing.
VITE_TTS_MODEL="gemini-2.5-flash-preview-tts"
