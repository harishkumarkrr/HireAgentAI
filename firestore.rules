rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "Harishkumarkrr@gmail.com" && request.auth.token.email_verified == true));
    }

    match /forms/{formId} {
      // Anyone can read a form (to respond to it)
      allow read: if true;
      // Only authenticated users can create forms
      allow create: if isAuthenticated();
      // Only the creator or admin can update/delete
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.creatorId == request.auth.uid);
    }

    match /responses/{responseId} {
      // Allow reading if admin, form creator, or if it's an active response (for the respondent)
      allow read: if isAdmin() || 
                  (isAuthenticated() && get(/databases/$(database)/documents/forms/$(resource.data.formId)).data.creatorId == request.auth.uid) ||
                  (resource.data.status == 'started');
      
      // Anyone can create a response
      allow create: if true;
      
      // Allow update if admin, form creator, or if it's an active response being updated by the respondent
      allow update: if isAdmin() || 
                    (isAuthenticated() && get(/databases/$(database)/documents/forms/$(request.resource.data.formId)).data.creatorId == request.auth.uid) ||
                    (resource.data.status == 'started' && 
                     request.resource.data.formId == resource.data.formId);
      
      // Only admin or form creator can delete
      allow delete: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/forms/$(resource.data.formId)).data.creatorId == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
